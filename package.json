{
  "name": "lacodiciadelsabio-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /lacodiciadelsabioweb/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sync-app": "node scripts/sync-from-app.mjs",
    "pdfs": "node scripts/generate-manual-pdfs.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@supabase/supabase-js": "^2.95.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
